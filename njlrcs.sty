\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{njlrcs}
\RequirePackage{ifthen}
\ProcessOptions\relax
%
\def\rcsNameTitle{rcsNone}
\def\rcsNameMajor{0}
\def\rcsNameMinor{0}
\def\rcsNameUpdate{0}

\def\rcsParseName $Name#1$ {
   \ifthenelse{\equal{#1}{}\or\equal{#1}{:  }}{}  % Then do nothing else ...
   {\@rcsParseNameCrackString #1}}

\def\@rcsParseNameCrackString : #1-#2-#3-#4 {
   \def\rcsNameTitle{#1}
   \def\rcsNameMajor{#2}
   \def\rcsNameMinor{#3}
   \def\rcsNameUpdate{#4}}

\newcommand{\rcsShowName}{
   \ifthenelse{\equal{\rcsNameTitle}{rcsNone}}%
      {\emph{Warning: Not an RCS configured version!}}%
      {\rcsNameMajor .\rcsNameMinor%
       \ifthenelse{\equal{0}\rcsNameUpdate}{}{%
        .\rcsNameUpdate}}}

\endinput
%
%% End of file 'njlrcs.sty'