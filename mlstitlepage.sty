\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mlstitlepage}
%
\RequirePackage[svgnames]{xcolor}
\RequirePackage{graphicx}
\RequirePackage{calc}
%
\ProcessOptions\relax
%
% -------------------------------------- Stuff to do with the title page
%
\newcommand{\@coverpicture}{}
\newcommand{\coverpicture}[1]{\renewcommand{\@coverpicture}{#1}}
%
\newcommand{\@jpld}{Not assigned}
\newcommand{\jpld}[1]{\renewcommand{\@jpld}{#1}}
\newcommand{\@otherrefs}{}
\newcommand{\otherrefs}[1]{\renewcommand{\@otherrefs}{#1}}
\newcommand{\@shorttitle}{}
\newcommand{\shorttitle}[1]{\renewcommand{\@shorttitle}{#1}}
\newcommand{\@version}{}
\newcommand{\version}[1]{\renewcommand{\@version}{#1}}
%
\pagestyle{empty}
%
\renewcommand{\maketitle}{{%
   \enlargethispage{0.5in}
   \begin{raggedright}\color{ChapterColor}
   \mdseries\upshape\sffamily\Large{JPL D-\@jpld}\\
   \mdseries\upshape\sffamily\large\@otherrefs % \\ is in \@otherrefs
   \mdseries\upshape\sffamily
   \vfil
   \LARGE\bfseries
   \href{https://aura.gsfc.nasa.gov/}{Earth Observing System (EOS)}\\
   \vfil %\vspace{0.3in}
   \href{https://mls.jpl.nasa.gov/}{Aura Microwave Limb Sounder (MLS)}\\
   \vfil
   \bfseries\upshape\sffamily\Huge\color{SectionColor}\@title\\
   %
   % Now the pictures
   %
   \begin{tabular}{@{}l@{}r@{}}
     \parbox[m]{5cm}{\includegraphics[width=5cm]{eos_mls_decal_lowres}}
     &
     \parbox[m]{\linewidth-5cm}{\@coverpicture}\\
   \end{tabular}
   %
   % Now the lower stuff
   %
   \color{black}
   \vfil
   \mdseries\upshape\sffamily\large\@author
   \vfil
   \bfseries\upshape\sffamily\Large Version \@version\\
   \large\mdseries\@date\\
   \vfil
   \includegraphics[width=2cm]{jpllogo-red}\\
   \large
   Jet Propulsion Laboratory\\
   California Institute of Technology\\
   Pasadena, California, 91109-8099

   \vspace{2ex}\copyright\ \the\year\ California Institute of Technology.  Government
   sponsorship acknowledged.
   \end{raggedright}
   \clearpage
}}
